def print_backends() -> None:
    rows = [
        ("ffmpeg", have("ffmpeg"), "audio, video, webp and exotic images",
         "brew install ffmpeg"),
        ("sips", IS_MAC and have("sips"), "images, heic, pdf (built in)", ""),
        ("textutil", IS_MAC and have("textutil"),
         "txt, rtf, html, doc, docx, odt (built in)", ""),
        ("cupsfilter", IS_MAC and have("cupsfilter"),
         "documents to pdf (built in)", ""),
        ("qlmanage", IS_MAC and have("qlmanage"),
         "svg and odd formats to png (built in)", ""),
        ("imagemagick", have("magick"), "images (optional, tried first)",
         "brew install imagemagick"),
        ("pandoc", have("pandoc"), "markdown, epub, latex, rst",
         "brew install pandoc"),
        ("pdftotext", have("pdftotext"), "pdf to text",
         "brew install poppler"),
    ]
    print("backends")
    for name, present, what, install in rows:
        mark = "yes" if present else "no "
        line = f"  [{mark}] {name:<12} {what}"
        if not present and install:
            line += f"  ({install})"
        print(line)
    try:
        _yaml()
        yaml_ok = True
    except ConvError:
        yaml_ok = False
    print(f"  [{'yes' if yaml_ok else 'no '}] yaml         "
          f".yaml and .yml data files"
          f"{'' if yaml_ok else '  (pip install pyyaml)'}")
    print("\nbuilt in, always available")
    print("  data      csv, tsv, json, jsonl, plist")
    print("  archives  zip, tar, tar.gz, tar.bz2, tar.xz, gz, bz2, xz")


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="Convert files. The last argument is the format you want.",
        epilog=EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("args", nargs="*", metavar="INPUT",
                        help="one or more input files, then the target format")
    parser.add_argument("-o", "--output", metavar="PATH",
                        help="write to this exact path (single input only)")
    parser.add_argument("-d", "--dir", metavar="DIR",
                        help="write results into DIR instead of alongside")
    parser.add_argument("-x", "--extract", action="store_true",
                        help="unpack archives instead of converting them")
    parser.add_argument("-f", "--force", action="store_true",
                        help="overwrite existing files")
    parser.add_argument("-q", "--quality", type=int, metavar="N",
                        help="image quality, 1 to 100")
    parser.add_argument("-b", "--bitrate", metavar="RATE",
                        help="audio or video bitrate, e.g. 192k")
    parser.add_argument("-n", "--dry-run", action="store_true",
                        help="show what would happen, change nothing")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="print the commands being run")
    parser.add_argument("--list", action="store_true",
                        help="show which converters are installed")
    parser.add_argument("-V", "--version", action="version",
                        version=f"{PROG} {VERSION}")
    opt = parser.parse_args(argv)

    if opt.list:
        print_backends()
        return 0
    if len(opt.args) < (1 if opt.extract else 2):
        parser.print_help(sys.stderr)
        return 2
    if opt.quality is not None and not 1 <= opt.quality <= 100:
        print(f"{PROG}: quality must be between 1 and 100", file=sys.stderr)
        return 2

    if opt.extract:
        inputs = [Path(a) for a in opt.args]
        stray = [p for p in inputs
                 if not p.exists() and str(p).lstrip(".").lower() in ARCHIVE]
        if stray:
            print(f"{PROG}: -x reads the format from each archive; drop the "
                  f"trailing '{stray[0]}'", file=sys.stderr)
            return 2
        if opt.output and len(inputs) > 1:
            print(f"{PROG}: -o takes a single input; use -d to send many "
                  f"archives to a folder", file=sys.stderr)
            return 2
        claimed = {}
        for src in inputs:
            dst = extract_target(src, opt)
            if dst in claimed:
                print(f"{PROG}: {claimed[dst]} and {src} would both become "
                      f"{dst}", file=sys.stderr)
                return 2
            claimed[dst] = src
        failures = 0
        for src in inputs:
            try:
                extract_one(src, opt)
            except Exception as exc:
                if opt.verbose and not isinstance(exc, ConvError):
                    traceback.print_exc()
                print(f"{PROG}: {src}: {readable(exc)}", file=sys.stderr)
                failures += 1
        return 1 if failures else 0

    fmt = opt.args[-1].lstrip(".").lower()
    inputs = [Path(a) for a in opt.args[:-1]]

    if os.sep in fmt or Path(fmt).exists():
        print(f"{PROG}: the last argument is the target format, not a path "
              f"— try '{PROG} {inputs[0]} {ext_of(fmt) or 'jpg'}', or use -o "
              f"to name the output", file=sys.stderr)
        return 2
    if opt.output and len(inputs) > 1:
        print(f"{PROG}: -o takes a single input; use -d to send many files "
              f"to a folder", file=sys.stderr)
        return 2

    if len(inputs) > 1:
        claimed = {}
        for src in inputs:
            dst = target_path(src, fmt, opt)
            if dst in claimed:
                print(f"{PROG}: {claimed[dst]} and {src} would both become "
                      f"{dst}", file=sys.stderr)
                return 2
            claimed[dst] = src

    failures = 0
    for src in inputs:
        try:
            convert_one(src, fmt, opt)
        except Exception as exc:
            if opt.verbose and not isinstance(exc, ConvError):
                traceback.print_exc()
            print(f"{PROG}: {src}: {readable(exc)}", file=sys.stderr)
            failures += 1
    return 1 if failures else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
